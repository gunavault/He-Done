DISCORD_TOKEN=ISI_TOKEN_BOT
GUILD_ID=ISI_ID_SERVER
CHANNEL_ID=ISI_ID_CHANNEL
ROLE_ID=ISI_ID_ROLE
# Jadwal default harian WIB untuk index yang belum diupdate lewat /trex
# Timer /trex tersimpan di database dan mengganti semua jam default index tersebut
INDEX_31_TIMES=11:20,18:00
INDEX_32_TIMES=12:47,19:27
# Pengingat teks dan voice H-30/H-15
REMINDER_MINUTES=30,15
DB_PATH=data/trex.sqlite3

# Opsional: ID voice channel biasa, bukan CHANNEL_ID untuk notifikasi teks.
# Kosong = fitur suara nonaktif. Isi lalu restart untuk mengaktifkan.
VOICE_CHANNEL_ID=
# Rekaman MP3 untuk setiap index dan H-30/H-15, termasuk test.mp3
VOICE_AUDIO_DIR=assets/voice
# MP3 penutup diputar setelah rekaman pengumuman. Kosongkan untuk menonaktifkan MP3.
VOICE_OUTRO_PATH=assets/outro.mp3
# Opsional jika FFmpeg bawaan wheel tidak cocok dengan hosting:
FFMPEG_PATH=
